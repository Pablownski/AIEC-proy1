# Copiar a apps/api/.env y configurar localmente; no versionar el archivo real.
# Docker Compose carga este archivo únicamente en el servicio api.
AGENT_PROVIDER=groq
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
MOCK_AGENT_DELAY_SECONDS=0.4
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Referencia configurable; ajustar a la cuota real de la organización (no la aumenta).
GROQ_TPM_BUDGET=8000
GROQ_TURN_TOKEN_BUDGET=7000
TMDB_API_KEY=
GOOGLE_BOOKS_API_KEY=
# Para usar MockAgent también puede elegirse AGENT_PROVIDER=mock aquí.
