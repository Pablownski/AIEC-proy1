# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat

# Backend (apps/api)
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
MOCK_AGENT_DELAY_SECONDS=0.4

# Groq: configurar solo en apps/api/.env, nunca en variables NEXT_PUBLIC_*.
# Opcional mientras el chatbot utilice MockAgent.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AGENT_PROVIDER=mock
# API key v3 de TMDB (no token Bearer); solo backend.
TMDB_API_KEY=
# Opcional: algunas cuotas/regiones de Google Books pueden exigirla.
GOOGLE_BOOKS_API_KEY=
